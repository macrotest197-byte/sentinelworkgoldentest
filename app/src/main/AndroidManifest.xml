<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Telegram (envÃ­o de alertas). Transparente para el usuario autorizado. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Alarma local -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Notificaciones (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Servicio en primer plano para mantener la alarma activa -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".SentinelApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sentinel">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Sentinel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Entrada de texto CONSENTIDA: el operador selecciona ("Procesar texto") o
             comparte texto hacia SENTINEL para verificarlo. No hay captura de fondo. -->
        <activity
            android:name=".ui.input.EvaluateTextActivity"
            android:exported="true"
            android:label="SENTINEL â€” verificar"
            android:theme="@style/Theme.Sentinel">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Pantalla de alerta a pantalla completa (se muestra sobre el bloqueo). -->
        <activity
            android:name=".alarm.AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Sentinel" />

        <!-- Servicio en primer plano de la alarma local. -->
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Alerta de seguridad de recaudacion: alarma local sonora y vibratoria al detectar una coincidencia de la lista negra" />
        </service>

        <!-- Campo de demostraciÃ³n del teclado (interno). Solo habilitado en el build de pruebas;
             en el release corporativo el componente queda deshabilitado (no instanciable). -->
        <activity
            android:name=".ui.input.KeyboardPlaygroundActivity"
            android:enabled="${testToolsEnabled}"
            android:exported="false"
            android:label="Prueba del teclado SENTINEL" />

        <!-- Teclado SENTINEL (IME opt-in, fail-closed). -->
        <service
            android:name=".input.SentinelInputMethodService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/sentinel_input_method" />
        </service>

        <!-- Servicio de accesibilidad OPT-IN: solo detecciÃ³n/aviso en billeteras autorizadas.
             No exportado por la app; lo activa el usuario desde Ajustes de accesibilidad. -->
        <service
            android:name=".input.SentinelAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sentinel_accessibility_service" />
        </service>
        <receiver
            android:name=".work.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
